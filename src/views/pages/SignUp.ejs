<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LifeLink</title>
    <script src="https://kit.fontawesome.com/62301ddb39.js" crossorigin="anonymous"></script>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body,
        html {
            width: 100%;
            height: 100%;
        }

        #SignUp {
            width: 100%;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }


        .container {
            width: 90%;
            max-width: 1200px;
            height: 85%;
            display: flex;
            background: #fff;
            border-radius: 22px;
            overflow: hidden;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }

        p {
            margin-top: 15px;
            font-size: 14px;
            text-align: center;
        }

        #pic {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 50%;
            background: linear-gradient(to bottom, #e75d5d, rgba(214, 214, 214, 0.868));
            border-radius: 22px;
            /* padding: 20px; */
        }

        .form {
            width: 50%;
            padding: 50px 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background-color: white;
        }

        .title {
            font-size: 28px;
            font-weight: bold;
            color: #333;
            margin-bottom: 30px;
            text-align: center;
        }

        .details {
            display: flex;
            flex-direction: column;
            margin-bottom: 18px;
        }

        .sub_title {
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 6.5px;
            margin-left: 2.3%;
            color: #333;
        }


        .details i {
            margin-right: 6px;
            color: #f44336;
        }

        .sty {
            padding: 12px 14px;
            font-size: 15px;
            border: 1px solid #ccc;
            border-radius: 20px;
            outline: none;
        }

        .sty1 {
            padding: 12px 14px;
            font-size: 15px;
            border: 1px solid #ccc;
            border-radius: 20px;
            outline: none;
            width: 100%;
        }


        .btn {
            align-self: center;
            background-color: #a23238;
            color: #fcfbfb;
            padding: 14px;
            border: none;
            width: 100%;
            max-width: 320px;
            border-radius: 22px;
            font-weight: 700;
            font-size: 15px;
        }

        .btn:hover {
            background-color: #a83238;
        }


        .link {
            color: #000000;
            font-weight: 600;
            text-decoration: none;
        }

        .link:hover {
            color: #a23238;
            border-bottom: 1px solid rgb(33, 15, 15);
        }


        #btm {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            margin-bottom: 30px;
        }

        #pic img {
            width: 70%;
            height: 60%;
            object-fit: cover;
            /* position: fixed; */
            /* bottom: 47px; */
        }

        .sty:focus,
        .sty:hover,
        #box:focus,
        #box:hover {
            border-color: #a23238;
            box-shadow: 0 0 0 3px rgba(244, 67, 54, 0.2);
        }

        @media (max-width: 700px) {
            .container {
                height: auto;
                flex-direction: column;
                border-radius: 0;
                box-shadow: none;
            }

            #pic {
                margin-top: 11%;
                width: 100%;
                height: 250px;
                border-radius: 22px;
            }

            #pic img {
                width: 50%;
                height: auto;
                object-fit: contain;
            }

            .form {
                width: 100%;
                padding: 0 !important;
                border-radius: 0 0 22px 22px;
            }

            .btn {
                width: 100%;
            }
        }

        @media (max-width: 600px) {
            .title {
                font-size: 22px;
            }

            .sty {
                font-size: 14px;
                padding: 10px 12px;
            }

            .form {
                width: 100%;
                padding: 0 !important;
                border-radius: 0 0 22px 22px;
            }

            .btn {
                font-size: 14px;
                padding: 12px;
            }

            .sub_title {
                font-size: 13px;
            }

            #pic {
                height: 200px;
            }

            #pic img {
                width: 60%;
            }
        }

        #eye,
        .eye {
            width: 25px;
            height: 25px;
            outline: none;
            border: none;
            background: transparent;
            align-self: center;
        }

        #box {
            display: flex;
            justify-content: space-between;
            font-size: 15px;
            border: 1px solid #ccc;
            border-radius: 20px;
            outline: none;
            padding-right: 14px;
        }

        .msg {
            font-weight: 330;
        }

        .msgBox {
            display: flex;
            margin: 1.2rem;
            flex-direction: column;
            line-height: 1.3;

        }
    </style>
</head>

<body>
    <div id="SignUp">

        <div class="container">
            <div id="pic">
                <img src="Assets/pic.png" alt="Donation">
            </div>
            <div class="form" id="SignUpForm">
                <h2></h2>
                <p class="title">SignUp</p>
                <div class="inputs">
                    <form action="" method="post" id="form1">
                        <div class="details">
                            <label class="sub_title" for="name"><i class="fa-solid fa-user"></i>Name</label>
                            <input name="name" placeholder="Enter your full name" class="sty" type="text" id="name"
                                required>
                        </div>
                        <div class="details">
                            <label class="sub_title" for="email"> <i class="fa-solid fa-envelope"></i>Email</label>
                            <input name="email" placeholder="Enter your email" id="email" class="sty" type="email"
                                required>
                        </div>
                        <div class="details">
                            <label class="sub_title" for="password"> <i class="fas fa-lock"></i> Password</label>
                            <div id="box">
                                <input name="password" placeholder="Enter your password" id="password" class="sty1"
                                    type="password" autocomplete="current-password" style="border: none;" required>
                                <button id="eye"><i id="icon" class="fa-solid fa-eye"
                                        style="color: #e31621;"></i></button>
                            </div>

                        </div>
                        <div class="details">
                            <label class="sub_title" for="date"> <i class="fa-solid fa-calendar"></i> Date Of
                                Birth</label>
                            <input name="dateOfBirth" placeholder="Date Of Birth" id="date" class="sty" type="date"
                                required>
                        </div>
                        <div id="btm">
                            <button type="button" class="btn" id="signIn">Sign Up</button>
                            <p>Have an Account? <a class="link" href="LOGIN">Login Here!</a>
                                </a></p>
                        </div>

                </div>
                </form>
            </div>
            <div class="form" style="display: none;" id="Profile">
                <div class="msgBox">
                    <h2 class="msg">Welcome </h2>
                    <h2 class="msg">Connecting Lives </h2>
                    <h2 class="msg">One drop, at a time ! </h2>
                </div>
                <div class="inputs">
                    <form action="" method="post" id="form2">
                        <div class="details">
                            <label class="sub_title" for="name"> <i class="fas fa-tint"></i>Blood Group</label>
                            <select class="sty" id="bloodGroup" name="bloodGroup" required>
                                <option value="">Select Blood Group</option>
                                <option value="A+">A+</option>
                                <option value="A-">A-</option>
                                <option value="B+">B+</option>
                                <option value="B-">B-</option>
                                <option value="AB+">AB+</option>
                                <option value="AB-">AB-</option>
                                <option value="O+">O+</option>
                                <option value="O-">O-</option>
                            </select>
                        </div>
                        <div class="details" style="gap: 10px;">
                            <!-- <label class="sub_title" for="aadhar"> <i class="fa-regular fa-address-card"></i>Your Aadhar
                                No</label>
                            <input name="AadharNo" placeholder="Aadhar No :" id="aadhar" class="sty" type="number"
                                required> -->

                            <div id="box">
                                <input name="phone" class="sty1" type="text" id="phone" placeholder="Enter phone">
                                <button type="button" class="eye" >Send
                                    OTP</button>
                            </div>
                            <div id="box">
                                <input name="otp" class="sty1" type="text" id="otp" placeholder="Enter OTP">
                                <button type="button" class="eye" >Verify OTP</button>

                            </div>

                        </div>
                        <div class="details">
                            <label class="sub_title" for="password1"> <i class="fas fa-map-marked-alt"></i></i>
                                Location</label>
                            <div id="box">
                                <input name="Location" placeholder="Current Location" id="password1" class="sty1"
                                    type="location " autocomplete="current-password" style="border: none;" required>
                            </div>
                        </div>
                        <div id="btm">
                            <button type="submit" class="btn" style="font-weight: 400;">Started </button>

                        </div>

                </div>
                </form>
            </div>

        </div>
    </div>
</body>

<script src="./js/SignUp.js"></script>
<!-- <script src="/auth.js"></script> -->

</html>
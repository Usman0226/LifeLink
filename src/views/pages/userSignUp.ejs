
  <div class="container userSignUp">
    <p class="title">Sign Up</p>
    <form action="" method="post" id="form1">
      <div class="details">
        <label class="sub_title" for="name"><i class="fa-solid fa-user"></i> Name</label>
        <input name="name" placeholder="Enter your full name" class="sty" type="text" id="name" required>
      </div>
      <div class="details">
        <label class="sub_title" for="email"><i class="fa-solid fa-envelope"></i> Email</label>
        <input name="email" placeholder="Enter your email" id="email" class="sty" type="email" required>
      </div>
      <div class="details">
        <label class="sub_title" for="phone"><i class="fa-solid fa-phone"></i> Phone Number</label>
        <input name="phone" placeholder="Enter your phone number" id="phone" class="sty" type="tel" required>
      </div>
      <button type="submit" class="btn">Sign Up</button>
      <p>Already have an account? <a class="link" href="LOGIN">Login here</a></p>
    </form>
  </div>
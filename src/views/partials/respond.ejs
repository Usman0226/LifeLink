<div id="respondFormOverlay" class="request-form-overlay"></div>
<div id="respondFormModal" class="respond-form">
    <form onclick="respondForm()">
        <button type="button" id="close" class="close-btn" aria-label="Close Emergency Form"
            style="background: #1a1110; color: #fff; max-height:50px;font-size:large">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="32" height="32" fill="rgba(0,0,0,1)"
                id="close-svg" class="close-path">
                <path
                    d="M12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12C22 17.5228 17.5228 22 12 22ZM12 10.5858L9.17157 7.75736L7.75736 9.17157L10.5858 12L7.75736 14.8284L9.17157 16.2426L12 13.4142L14.8284 16.2426L16.2426 14.8284L13.4142 12L16.2426 9.17157L14.8284 7.75736L12 10.5858Z"
                    class="close-path">
                </path>
            </svg></button>
        <h2>Respond Form</h2>
        <input id="hos" name="hospitalName" placeholder="Hospital Name">
        <select id="bloodGroup" name="bloodGroup" required>
            <option value="">Select Blood Group</option>
            <option value="A+">A+</option>
            <option value="A-">A-</option>
            <option value="B+">B+</option>
            <option value="B-">B-</option>
            <option value="AB+">AB+</option>
            <option value="AB-">AB-</option>
            <option value="O+">O+</option>
            <option value="O-">O-</option>
        </select>
        <input id="locationOf" type="text" name="location" placeholder="Location (e.g., Madanapalle)" />
        <input id="requester" type="text" name="contactName" placeholder="Your Full Name" value="<%= username %>"/>
        <input id="number" type="number" name="contactInfo" placeholder="Contact (Phone)" value="<%= phone %>"/>

        <label for="checkbox" style="opacity: 0.7;font-size: medium;">
            <input type="checkbox" id="checkbox" required style="width: 19px;">
            I confirm, I'm willing to donate the Blood.
        </label>

        <div style="display: flex; justify-content: center; gap: 1rem;">
            <button id="respond" type="submit" class="cta-btn" style="max-height:50px">Respond</button>
        </div>
    </form>
</div>
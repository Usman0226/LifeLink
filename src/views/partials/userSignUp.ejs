<div id="userSignUpOverlay">

  <div class="container " id="userSignUp">
    <p class="title">Sign In Required
      <button type="button" onclick="closeIt()" id="closeEmergencyFormBtn" class="close-btn" aria-label="Close Emergency Form"
      style="background:none; color: #fff; max-height:50px;font-size:large; border:none"><svg
            xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="32" height="32" fill="rgba(0,0,0,1)">
            <path
                d="M12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12C22 17.5228 17.5228 22 12 22ZM12 10.5858L9.17157 7.75736L7.75736 9.17157L10.5858 12L7.75736 14.8284L9.17157 16.2426L12 13.4142L14.8284 16.2426L16.2426 14.8284L13.4142 12L16.2426 9.17157L14.8284 7.75736L12 10.5858Z">
              </path>
        </svg>
      </button>
    </p>
    <form onclick="handleUserSubmission() " action="/submit/newUser/userInfo" method="post" id="form1" class="userForm">
      <div class="details">
        <label class="sub_title" for="name"><i class="fa-solid fa-user"></i> Name</label>
      <input name="name" placeholder="Enter your full name" class="sty" type="text" id="name" required>
    </div>
    <div class="details">
      <label class="sub_title" for="email"><i class="fa-solid fa-envelope"></i> Email</label>
      <input name="email" placeholder="Enter your email" id="email" class="sty" type="email" required>
    </div>
    <div class="details">
      <label class="sub_title" for="phone"><i class="fa-solid fa-phone"></i> Phone Number</label>
      <input name="phone" placeholder="Enter your phone number" id="phone" class="sty" type="tel" required>
    </div>
    <button type="submit" class="btn">Sign Up</button>
    <p>Already have an account? <a class="link" href="LOGIN">Login here</a></p>
  </form>
</div>

</div>
<div id="profileContainer">

    <div class="user">
        <img src="/" alt="ProfileImage">
        <h3>User : <strong>
                <%= user.username %>
            </strong></h3>
    </div>

    <div id="details">
        <h3>Blood Group : <strong>
                <%= user.bloodGroup %>
            </strong></h3>
        <h3>Location : <strong>
                <%= user.location %>
            </strong></h3>
        <h3>Mobile No : <strong>
                <%= user.phone %>
            </strong></h3>
    </div>
    <form action="/logout" method="post" >
        <div class="logout" style="display:flex ;justify-content: center;">
            <button class="cta-btn" type="submit" style="align-self: center;border-radius:6px;align-items:center;width:auto; max-height:45px;padding:10px; text-align:center" type="button">Logout</button>
        </div>
    </form>


</div>
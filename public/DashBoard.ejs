<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LifeLink - Home</title>
    <link rel="stylesheet" href="./css/style.css">
    <script src="https://kit.fontawesome.com/62301ddb39.js" crossorigin="anonymous"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

</head>

<body>
    <header>
        <div class="header-container">
            <h1 class="logo">LifeLink</h1>
            <button id="menuToggle" class="hamburger"><i class="fas fa-bars"></i></button>
            <nav id="navMenu">
                <a href="#">Home</a>
                <a href="#">Profile</a>
                <a href="#">About</a>
                <a href="#">Contact</a>
            </nav>
        </div>
    </header>

    <button id="emergencyRequestBtn"><i style="margin-right: 8px;" class="fa-solid fa-truck-droplet"></i>Emergency
        Request</button>

    <section class="hero">
        <div class="hero-text">
            <h2><span>Connecting Donors</span><br><span>to Lives in Need</span></h2>
            <p>LifeLink - Bridge the gap between donor and the people in need! Join our community and make every drop
                count.</p>
            <button id="donateNowBtn" class="cta-btn donate-sumbit" style="margin-bottom: 15px;">Donate Now</button>
        </div>
        <img src="./Assets/Mesh.png" alt="LifeLink Hero Section" />
    </section>

    <section class="features">
        <div class="feature">
            <i class="fa-solid fa-heart-circle-plus"></i>
            <h4>Life's Saved</h4>
            <p>Get notified when someone near you needs help.</p>
        </div>
        <div class="feature">
            <i class="fas fa-map-marked-alt"></i>
            <h4>Smart Location Match</h4>
            <p>We intelligently connect donors with those in need.</p>
        </div>
        <div class="feature">
            <i class="fa-solid fa-hand-holding-droplet"></i>
            <h4>On Going Requests</h4>
            <p>Track and plan your next donation session easily.</p>
        </div>
        <div class="feature">
            <i class="fas fa-tint"></i>
            <h4>Active Donors</h4>
            <p>Track and plan your next donation session easily.</p>
        </div>
    </section>


    <div id="emergencyFormOverlay" class="request-form-overlay"></div>
    <div id="emergencyFormModal" class="request-form">
        <h2 style="margin-bottom:10px;">Emergency Request Form</h2>
        <form id="emergencyRequestForm" method="post">
            <label for="bloodGroup">Blood Group</label>
            <select id="bloodGroup" name="bloodGroup" required>
                <option value="">Select Blood Group</option>
                <option value="A+">A+</option>
                <option value="A-">A-</option>
                <option value="B+">B+</option>
                <option value="B-">B-</option>
                <option value="AB+">AB+</option>
                <option value="AB-">AB-</option>
                <option value="O+">O+</option>
                <option value="O-">O-</option>
            </select>
            <select id="bloodUnits" name="bloodUnits"  required>
                <option value="">Select Units</option>
                <option value="1">1</option>
                <option value="2">2</option>
                <option value="3">3</option>
                <option value="4">4</option>
                <option value="5">5</option>
                <option value="6">6</option>
                <option value="7">7</option>
                <option value="8">8</option>
                <option value="9">9</option>
            </select>
            <input name="hospitalName" placeholder="Hospital Name">
            <input type="text" name="location" placeholder="Location (e.g., Madanapalle)" />
            <input type="text" name="contactName" placeholder="Your Full Name" />
            <input type="number" name="contactInfo" placeholder="Contact (Phone)" />
            <div class="confirmation" style="
                display: flex;
                justify-content:flex-start;
                align-items:center;
                gap:5px;
                padding:5px
             ">
                <input type="checkbox" id="checkbox" required style="width: 15px;margin:0; align-self:center;">
                <label for="checkbox" style="opacity: 0.7;font-size:small;">I confirm this is a genuine request</label>
            </div>
            
            <div style="display: flex; justify-content: center; gap: 1rem;">
                <button type="button" id="closeEmergencyFormBtn" class="cta-btn"
                    style="background: #1a1110; color: #fff; max-height:50px">Cancel</button>
                <button id="requestSubmission" type="submit" class="cta-btn" style="max-height:50px">Submit</button>
            </div>
        </form>
    </div>


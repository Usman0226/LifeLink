    <div class="blood-banks" style="margin-top: 0; padding-top: 0;">
        <h2 style="margin-top: 0;">Ongoing Emergency Requests</h2>
        <p style="text-align: center; margin-bottom: 20px; color: #555;">Your help is urgently required.</p>

        <div class="dashboard-section-filters">
            <select id="filter-blood-type">
                <option selected value="all">All Blood Types</option>
                <option value="A+">A+</option>
                <option value="A-">A-</option>
                <option value="B+">B+</option>
                <option value="B-">B-</option>
                <option value="AB+">AB+</option>
                <option value="AB-">AB-</option>
                <option value="O+">O+</option>
                <option value="O-">O-</option>
            </select>
            <input type="text" id="filter-location" placeholder="Filter by city">
        </div>

        <div id="emergency-requests-container" class="emergency-requests-table-container">
            <!-- js -->
        </div>
        <p id="no-requests-message" class="no-requests-message" style="display: none;">No requests match the current
            filters.</p>
    </div>

    <footer>
        &copy; 2025 LifeLink. All rights reserved.
    </footer>


    <script src="/js/main.js"></script>

</body>

</html>
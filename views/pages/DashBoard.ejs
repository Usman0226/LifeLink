<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LifeLink - Home</title>
    <link rel="stylesheet" href="./css/style.css">
    <script src="https://kit.fontawesome.com/62301ddb39.js" crossorigin="anonymous"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

</head>

<body>
    <header>
        <div class="header-container">
            <h1 class="logo">LifeLink</h1>
            <button id="menuToggle" class="hamburger"><i class="fas fa-bars"></i></button>
            <nav id="navMenu">
                <a href="/dashBoard">Home</a>
                <a href="#">Profile</a>
                <a href="#">About</a>
                <a href="#">Contact</a>
            </nav>
        </div>
    </header>

    <button id="emergencyRequestBtn"><i style="margin-right: 8px;" class="fa-solid fa-truck-droplet"></i>Emergency
        Request</button>

    <section class="hero">
        <div class="hero-text">
            <h2><span>Connecting Donors</span><br><span>to Lives in Need</span></h2>
            <p>LifeLink - Bridge the gap between donor and the people in need! Join our community and make every drop
                count.</p>
            <div class="ctabtns" style="gap: 10px;">
                <button id="donateNowBtn" class="cta-btn donate-sumbit" style="margin-bottom: 15px;">Donate Now</button>
                <button id="donorRegister" class="cta-btn donate-sumbit" style="margin-bottom: 15px;">Join as
                    Donor</button>
            </div>
        </div>
        <img src="./Assets/Mesh.png" alt="LifeLink Hero Section" />
    </section>


    <%- include("../partials/emergencyForm") %>

        <div class="blood-banks" style="margin-top: 0; padding-top: 0;">
            <h2>Ongoing Emergency Requests</h2>
            <p style="text-align: center; margin-bottom: 20px; color: #555;">Your help is urgently required.</p>

            <div class="dashboard-section-filters">
                <select id="filter-blood-type">
                    <option selected value="all">All Blood Types</option>
                    <option value="A+">A+</option>
                    <option value="A-">A-</option>
                    <option value="B+">B+</option>
                    <option value="B-">B-</option>
                    <option value="AB+">AB+</option>
                    <option value="AB-">AB-</option>
                    <option value="O+">O+</option>
                    <option value="O-">O-</option>
                </select>
                <input type="text" id="filter-location" placeholder="Filter by city">
            </div>

            <div id="emergency-requests-container" class="emergency-requests-table-container">
                <!-- js -->
            </div>
            <p id="no-requests-message" class="no-requests-message" style="display: none;">No requests match the current
                filters.</p>
        </div>




        <section class="features">
            <div class="feature">
                <i class="fa-solid fa-heart-circle-plus"></i>
                <h4>Life's Saved</h4>
                <p>Get notified when someone near you needs help.</p>
            </div>
            <div class="feature">
                <i class="fas fa-map-marked-alt"></i>
                <h4>Smart Location Match</h4>
                <p>We intelligently connect donors with those in need.</p>
            </div>
            <div class="feature">
                <i class="fa-solid fa-hand-holding-droplet"></i>
                <h4>On Going Requests</h4>
                <p>Track and plan your next donation session easily.</p>
            </div>
            <div class="feature">
                <i class="fas fa-tint"></i>
                <h4>Active Donors</h4>
                <p>Track and plan your next donation session easily.</p>
            </div>
        </section>

        <footer>
            &copy; 2025 LifeLink. All rights reserved.
        </footer>


        <script src="/js/main.js"></script>
        <% if (jsfile && Array.isArray(jsfile)) { %>
            <% jsfile.forEach((e)=> { %>
                <script src="/js/<%= e %>.js"></script>
                <% }) %>
                    <% } %>

</body>

</html>
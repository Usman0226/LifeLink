<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LifeLink - Home</title>
    <link rel="stylesheet" href="./css/style.css">
    <script src="https://kit.fontawesome.com/62301ddb39.js" crossorigin="anonymous"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

</head>

<body>
    <header>
        <div class="header-container">
            <h1 class="logo">LifeLink</h1>
            <button id="menuToggle" class="hamburger">
                <svg class="icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor"
                    viewBox="0 0 448 512">
                    <path
                        d="M0 96c0-17.7 14.3-32 32-32h384c17.7 0 32 14.3 32 32s-14.3 32-32 32H32C14.3 128 0 113.7 0 96zm0 160c0-17.7 14.3-32 32-32h384c17.7 0 32 14.3 32 32s-14.3 32-32 32H32c-17.7 0-32-14.3-32-32zm448 160c0 17.7-14.3 32-32 32H32c-17.7 0-32-14.3-32-32s14.3-32 32-32h384c17.7 0 32 14.3 32 32z" />
                </svg>
            </button>

            <nav id="navMenu">
                <a href="/dashBoard">Home</a>
                <a href="#">Live Requests</a>
                <a href="#">About</a>
                <a href="#">Profile</a>
            </nav>
        </div>
    </header>

    <button id="emergencyRequestBtn"><i style="margin-right: 8px;" class="fa-solid fa-truck-droplet"></i>Emergency
        Request</button>

    <section class="hero">
        <div class="hero-text">
            <h2><span>Connecting Donors</span><br><span>to Lives in Need</span></h2>
            <p>LifeLink - Bridge the gap between donor and the people in need! Join our community and make every drop
                count.</p>
            <div class="ctabtns" style="gap: 10px;">
                <button id="donateNowBtn" class="cta-btn donate-sumbit" style="margin-bottom: 15px;">Donate Now</button>
                <button id="donorRegister" class="cta-btn donate-sumbit" style="margin-bottom: 15px;">Join as
                    Donor</button>
            </div>
        </div>
        <img src="./Assets/Mesh.jpg" alt="LifeLink Hero Section" />
    </section>


    <%- include("../partials/emergencyForm") %>
        <section class="features">
            <div class="feature">
                <!-- heart -->
                <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                    <path
                        d="M273 151.1L288 171.8L303 151.1C328 116.5 368.2 96 410.9 96C484.4 96 544 155.6 544 229.1L544 231.7C544 249.3 540.6 267.3 534.5 285.4C512.7 276.8 488.9 272 464 272C358 272 272 358 272 464C272 492.5 278.2 519.6 289.4 544C288.9 544 288.5 544 288 544C272.5 544 257.2 539.4 244.9 529.9C171.9 474.2 32 343.9 32 231.7L32 229.1C32 155.6 91.6 96 165.1 96C207.8 96 248 116.5 273 151.1zM464 320C543.5 320 608 384.5 608 464C608 543.5 543.5 608 464 608C384.5 608 320 543.5 320 464C320 384.5 384.5 320 464 320zM480 400C480 391.2 472.8 384 464 384C455.2 384 448 391.2 448 400L448 448L400 448C391.2 448 384 455.2 384 464C384 472.8 391.2 480 400 480L448 480L448 528C448 536.8 455.2 544 464 544C472.8 544 480 536.8 480 528L480 480L528 480C536.8 480 544 472.8 544 464C544 455.2 536.8 448 528 448L480 448L480 400z" />
                </svg>
                <h4>Life's Saved</h4>
                <p>Get notified when someone near you needs help.</p>
            </div>
            <div class="feature">
                <!-- map -->
                <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                    <path
                        d="M576 112C576 100.9 570.3 90.6 560.8 84.8C551.3 79 539.6 78.4 529.7 83.4L413.5 141.5L234.1 81.6C226 78.9 217.3 79.5 209.7 83.3L81.7 147.3C70.8 152.8 64 163.9 64 176L64 528C64 539.1 69.7 549.4 79.2 555.2C88.7 561 100.4 561.6 110.3 556.6L226.4 498.5L399.7 556.3C395.4 549.9 391.2 543.2 387.1 536.4C376.1 518.1 365.2 497.1 357.1 474.6L255.9 440.9L255.9 156.4L383.9 199.1L383.9 298.4C414.9 262.6 460.9 240 511.9 240C534.5 240 556.1 244.4 575.9 252.5L576 112zM512 288C445.7 288 392 340.8 392 405.9C392 474.8 456.1 556.3 490.6 595.2C502.2 608.2 521.9 608.2 533.5 595.2C568 556.3 632.1 474.8 632.1 405.9C632.1 340.8 578.4 288 512.1 288zM472 408C472 385.9 489.9 368 512 368C534.1 368 552 385.9 552 408C552 430.1 534.1 448 512 448C489.9 448 472 430.1 472 408z" />
                </svg>
                <h4>Smart Location Match</h4>
                <p>We intelligently connect donors with those in need.</p>
            </div>
            <div class="feature">
                <!-- hand -->
                <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                    <path
                        d="M307.5 70.6L241.2 167C230 183.3 224 202.6 224 222.3L224 224C224 277 267 320 320 320C373 320 416 277 416 224L416 222.3C416 202.5 410 183.3 398.8 167L332.5 70.6C329.7 66.5 325 64 320 64C315 64 310.3 66.5 307.5 70.6zM141.3 405.5L98.7 448L64 448C46.3 448 32 462.3 32 480L32 544C32 561.7 46.3 576 64 576L384.5 576C413.5 576 441.8 566.7 465.2 549.5L591.8 456.2C609.6 443.1 613.4 418.1 600.3 400.3C587.2 382.5 562.2 378.7 544.4 391.8L424.6 480L312 480C298.7 480 288 469.3 288 456C288 442.7 298.7 432 312 432L384 432C401.7 432 416 417.7 416 400C416 382.3 401.7 368 384 368L231.8 368C197.9 368 165.3 381.5 141.3 405.5z" />
                </svg>
                <h4>On Going Requests</h4>
                <p>Track and plan your next donation session easily.</p>
            </div>
            <div class="feature">
                <!-- drop -->
                <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
                    <path
                        d="M320 576C214 576 128 490 128 384C128 292.8 258.2 109.9 294.6 60.5C300.5 52.5 309.8 48 319.8 48L320.2 48C330.2 48 339.5 52.5 345.4 60.5C381.8 109.9 512 292.8 512 384C512 490 426 576 320 576zM240 376C240 362.7 229.3 352 216 352C202.7 352 192 362.7 192 376C192 451.1 252.9 512 328 512C341.3 512 352 501.3 352 488C352 474.7 341.3 464 328 464C279.4 464 240 424.6 240 376z" />
                </svg>
                <h4>Active Donors</h4>
                <p>Track and plan your next donation session easily.</p>
            </div>
        </section>

        <div class="blood-banks" style="margin-top: 0; padding-top: 0;">
            <h2>Ongoing Emergency Requests</h2>
            <p style="text-align: center; margin-bottom: 20px; color: #555;">Your help is urgently required.</p>

            <div class="dashboard-section-filters">
                <select id="filter-blood-type">
                    <option selected value="all">All Blood Types</option>
                    <option value="A+">A+</option>
                    <option value="A-">A-</option>
                    <option value="B+">B+</option>
                    <option value="B-">B-</option>
                    <option value="AB+">AB+</option>
                    <option value="AB-">AB-</option>
                    <option value="O+">O+</option>
                    <option value="O-">O-</option>
                </select>
                <input type="text" id="filter-location" placeholder="Filter by city">
            </div>

            <div id="emergency-requests-container" class="emergency-requests-table-container">
                <!-- js -->
            </div>
            <p id="no-requests-message" class="no-requests-message" style="display: none;">No requests match the current
                filters.</p>
        </div>





        <footer>
            &copy; 2025 LifeLink. All rights reserved.
        </footer>


        <script src="/js/main.js"></script>
        <% if (jsfile && Array.isArray(jsfile)) { %>
            <% jsfile.forEach((e)=> { %>
                <script src="/js/<%= e %>.js"></script>
                <% }) %>
                    <% } %>

</body>

</html>
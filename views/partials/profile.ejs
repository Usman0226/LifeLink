<div id="profileContainer">

    <div class="user">
        <img src="/" alt="ProfileImage">
        <h3>User : <strong>
                <%= user.username %>
            </strong></h3>
    </div>

    <div id="details">
        <h3>Blood Group : <strong>
                <%= user.bloodGroup %>
            </strong></h3>
        <h3>Location : <strong>
                <%= user.location %>
            </strong></h3>
        <h3>Mobile No : <strong>
                <%= user.phone %>
            </strong></h3>
    </div>

    <div class="logout">
        <button type="button">Logout</button>
    </div>

</div>
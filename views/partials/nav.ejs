<style>
    header {
        width: 90%;
        background-color: rgba(185, 28, 28, 0.5);
        color: white;
        border-radius: 28px;
        padding: 1rem 1.5rem;
        backdrop-filter: blur(5px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        z-index: 99999;
        position: fixed;
        top: 10px;
        left: 50%;
        transform: translateX(-50%);
        max-height: 80px;
    }

    .header-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .logo {
        font-size: 24px;
        font-weight: bold;
    }

    nav {
        display: flex;
        gap: 20px;
        transition: background ease-in-out .8s;
    }

    nav a {
        color: white;
        text-decoration: none;
        font-weight: 600;
        font-size: 16px;
        position: relative;
        display: inline-block;
        padding-bottom: 4px;
    }

    nav a::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0%;
        height: 2px;
        background-color: white;
        transition: width 0.3s ease-in-out;
    }

    nav a:hover::after {
        width: 100%;
    }


    .hamburger {
        display: none;
        background: none;
        border: none;
        font-size: 24px;
        color: white;
        cursor: pointer;
    }

    @media (max-width: 768px) {
        .hamburger {
            display: block;
        }

        nav {
            position: absolute;
            top: 100%;
            right: 0;
            left: 0;
            background-color: rgba(185, 28, 28, 0.5);
            flex-direction: column;
            align-items: flex-start;
            padding: 1.2rem;
            display: none;
            border-radius: 28px;
            margin: 5px;
        }

        nav a {
            width: 100%;
            border-bottom: 1px solid #ffffff43;
        }

        nav.show {
            display: flex;
        }

        body {
            padding-top: 170px;
        }

        .hero {
            flex-direction: column;
            text-align: center;
            padding: 30px;
        }

        .hero-text,
        .hero img {
            max-width: 100%;
        }

        .features {
            flex-direction: column;
            align-items: center;
        }

        /* #emergencyRequestBtn {
            top: 125px;
            right: 0.5rem;
            font-size: 14px;
            padding: 8px 16px;
        } */
    }

    .feature i {
        transition: transform 0.4s ease, color 0.4s ease;
        display: inline-block;
    }


    .feature:hover i {
        animation: hoverFloat 0.6s ease forwards;
    }


    @keyframes hoverFloat {
        0% {
            transform: translateY(0) scale(1);
            rotate: -7deg;
        }

        50% {
            rotate: -7deg;
            transform: translateY(-10px) scale(1.2);
        }

        100% {
            rotate: -7deg;
            transform: translateY(0) scale(1);
        }
    }

</style>

<header>
    <div class="header-container">
        <h1 class="logo">LifeLink</h1>
        <button id="menuToggle" class="hamburger"><i class="fas fa-bars"></i></button>
        <nav id="navMenu">
            <a href="/dashBoard">Home</a>
            <a href="#">Profile</a>
            <a href="#">About</a>
            <a href="#">Contact</a>
        </nav>
    </div>
</header>

<button id="emergencyRequestBtn">
  <i class="fa-solid fa-truck-droplet" id="ambulance"></i>
  <span class="button-text">Emergency Request</span>
</button>

<script>

    const menuToggle = document.getElementById("menuToggle");
    const navMenu = document.getElementById("navMenu");

    menuToggle.addEventListener("click", () => {
        navMenu.classList.toggle("show");
    });

</script>
<style>
    header {
        width: 90%;
        background-color: rgba(185, 28, 28, 0.5);
        color: white;
        border-radius: 28px;
        padding: 1rem 1.5rem;
        backdrop-filter: blur(5px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        z-index: 99999;
        position: fixed;
        top: 10px;
        left: 50%;
        transform: translateX(-50%);
        max-height: 80px;
    }

    .header-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .logo {
        font-size: 24px;
        font-weight: bold;
    }

    nav {
        display: flex;
        gap: 20px;
        transition: background ease-in-out .8s;
    }

    nav a {
        color: white;
        text-decoration: none;
        font-weight: 600;
        font-size: 16px;
        position: relative;
        display: inline-block;
        padding-bottom: 4px;
    }

    nav a::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0%;
        height: 2px;
        background-color: white;
        transition: width 0.3s ease-in-out;
    }

    nav a:hover::after {
        width: 100%;
    }


    .hamburger {
        display: none;
        background: none;
        border: none;
        font-size: 24px;
        color: white;
        cursor: pointer;
    }

    @media (max-width: 768px) {
        .hamburger {
            display: block;
        }

        nav {
            position: absolute;
            top: 100%;
            right: 0;
            left: 0;
            background-color: rgba(185, 28, 28, 0.5);
            flex-direction: column;
            align-items: flex-start;
            padding: 1.2rem;
            display: none;
            border-radius: 28px;
            margin: 5px;
        }

        nav a {
            width: 100%;
            border-bottom: 1px solid #ffffff43;
        }

        nav.show {
            display: flex;
        }

        body {
            padding-top: 170px;
        }

        .hero {
            flex-direction: column;
            text-align: center;
            padding: 30px;
        }

        .hero-text,
        .hero img {
            max-width: 100%;
        }

        .features {
            flex-direction: column;
            align-items: center;
        }

        /* #emergencyRequestBtn {
            top: 125px;
            right: 0.5rem;
            font-size: 14px;
            padding: 8px 16px;
        } */
    }

    .feature i {
        transition: transform 0.4s ease, color 0.4s ease;
        display: inline-block;
    }


    .feature:hover i {
        animation: hoverFloat 0.6s ease forwards;
    }


    @keyframes hoverFloat {
        0% {
            transform: translateY(0) scale(1);
            rotate: -7deg;
        }

        50% {
            rotate: -7deg;
            transform: translateY(-10px) scale(1.2);
        }

        100% {
            rotate: -7deg;
            transform: translateY(0) scale(1);
        }
    }

</style>

<header>
    <div class="header-container">
        <h1 class="logo">LifeLink</h1>
        <button id="menuToggle" class="hamburger">
  <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
    <path d="M0 96C0 78.3 14.3 64 32 64H416c17.7 0 32 14.3 32 32s-14.3 32-32 32H32C14.3 128 0 113.7 0 96zM0 256c0-17.7 14.3-32 32-32H416c17.7 0 32 14.3 32 32s-14.3 32-32 32H32c-17.7 0-32-14.3 -32-32zM448 416c0 17.7-14.3 32-32 32H32c-17.7 0-32-14.3-32-32s14.3-32 32-32H416c17.7 0 32 14.3 32 32z"/></svg>
</button>

        <nav id="navMenu">
            <a href="/dashBoard">Home</a>
            <a href="#">Live Requests</a>
            <a href="#">About</a>
            <a href="#">Profile</a>
        </nav>
    </div>
</header>

<button id="emergencyRequestBtn">
  <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512" id="ambulance">
    <path d="M368 0C381.3 0 392 10.7 392 24V56H472.1C483.6 56 494.5 61.2 501.6 70.3L578.6 168.3C585.5 177.1 588.1 188.7 585.7 199.9L574.3 252.8C613.6 267.2 640 304.3 640 346.6V392C640 405.3 629.3 416 616 416H584.4C577.9 449.3 549.3 480 512 480C474.7 480 446.1 449.3 439.6 416H296.4C289.9 449.3 261.3 480 224 480C186.7 480 158.1 449.3 151.6 416H24C10.7 416 0 405.3 0 392V280C0 266.7 10.7 256 24 256H104V208C104 121.3 173.3 56 256 56H344V24C344 10.7 354.7 0 368 0zM464 128V192H555.5L506.5 128H464zM184 208V256H328V208H184zM176 384A32 32 0 1 0 176 448 32 32 0 1 0 176 384zM528 384A32 32 0 1 0 528 448 32 32 0 1 0 528 384z"/>
  </svg>
  <span class="button-text">Emergency Request</span>
</button>

<script>

    const menuToggle = document.getElementById("menuToggle");
    const navMenu = document.getElementById("navMenu");

    menuToggle.addEventListener("click", () => {
        navMenu.classList.toggle("show");
    });

</script>
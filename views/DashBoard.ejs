<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LifeLink - Blood Bank Locator</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.7.1/dist/leaflet.css" />
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <header class="header">
        <img src="/assets/images/Mesh.png" alt="LifeLink Logo">
        <h1>LifeLink Blood Bank Locator</h1>
    </header>

    <section class="search-section">
        <div class="search-container">
            <input type="text" id="citySearch" placeholder="Enter city name">
            <select id="serviceFilter">
                <option value="">All Services</option>
                <option value="Whole Blood">Whole Blood</option>
                <option value="Platelets">Platelets</option>
                <option value="Plasma">Plasma</option>
            </select>
            <button class="btn btn-primary" onclick="searchBloodBanks()">Search</button>
        </div>
    </section>

    <div id="map"></div>

    <section class="results-section">
        <div class="blood-bank-list" id="bloodBanksList"></div>
    </section>

    <footer>
        <p>&copy; 2025 LifeLink. All rights reserved.</p>
    </footer>

    <script src="https://unpkg.com/leaflet@1.7.1/dist/leaflet.js"></script>
    <script type="module" src="/js/main.js"></script>
</body>
</html>